# XBrush API Key (required)
# Get yours at https://xbrush.run/api-keys
XBRUSH_API_KEY=your_api_key_here

# Optional: override API base URL. Defaults to https://api.xbrush.run.
# XBRUSH_BASE_URL=

# Optional: comma-separated tool names to disable at startup.
# XBRUSH_DISABLED_TOOLS=xbrush_music_generate,xbrush_watermark_add
