exports[`도구 스키마 스냅샷 > xbrush_tts_generate 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "language": {
      "description": "Language/locale code (e.g. 'ko', 'en', 'ko-KR').",
      "type": "string",
    },
    "model": {
      "description": "TTS model ID (e.g. eleven-v3, speech-2.8-hd). Optional — server default is a Minimax model (which needs voice_id). Use xbrush_list_models with category='audio'.",
      "type": "string",
    },
    "speed": {
      "description": "Speech rate multiplier (0.5-2.0). Default: 1.0.",
      "maximum": 2,
      "minimum": 0.5,
      "type": "number",
    },
    "text": {
      "description": "Text to synthesize (non-blank).",
      "minLength": 1,
      "type": "string",
    },
    "voice_id": {
      "description": "Voice identifier. REQUIRED for Minimax models (speech-*); get one from xbrush_list_voices. ElevenLabs (eleven-v3) works without it.",
      "type": "string",
    },
  },
  "required": [
    "text",
  ],
  "type": "object",
}
`;

exports[`도구 스키마 스냅샷 > xbrush_video_lip_sync 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "audio_url": {
      "description": "URL of the speech audio to lip-sync. Alternative: text + voice_id (built-in TTS).",
      "format": "uri",
      "type": "string",
    },
    "duration": {
      "description": "Output duration in seconds (1-60). Model default if omitted.",
      "maximum": 60,
      "minimum": 1,
      "type": "number",
    },
    "image_url": {
      "description": "URL of a still portrait photo to animate — talking photo (fabric-1.0/-fast). Provide video_url OR image_url.",
      "format": "uri",
      "type": "string",
    },
    "model": {
      "description": "Lip-sync model ID: pixverse-lipsync / infinite-talk (video input), fabric-1.0 / fabric-1.0-fast (still-photo input, 'talking photo'). Defaults to the server's default model.",
      "type": "string",
    },
    "resolution": {
      "description": "Output resolution tier — currently "480p" or "720p" (higher costs more; e.g. fabric-1.0 480p 0.104 vs 720p 0.195 credits/sec). Server-validated.",
      "minLength": 1,
      "type": "string",
    },
    "text": {
      "description": "Text to speak via built-in TTS instead of audio_url (use with voice_id; see xbrush_list_voices).",
      "type": "string",
    },
    "video_url": {
      "description": "URL of the source face video (video-driven models). Provide video_url OR image_url.",
      "format": "uri",
      "type": "string",
    },
    "voice_id": {
      "description": "Voice for built-in TTS when using text (from xbrush_list_voices).",
      "type": "string",
    },
  },
  "type": "object",
}
`;

