{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "frequency_penalty": {
      "description": "Penalize frequent tokens (-2 to 2). Ignored on models with constraints.penaltiesHonored:false (gemini, anthropic, grok).",
      "maximum": 2,
      "minimum": -2,
      "type": "number",
    },
    "max_tokens": {
      "description": "Upper bound on generated tokens (1-65536), reasoning included. Keep modest — the response must finish within the ~30s gateway limit.",
      "maximum": 65536,
      "minimum": 1,
      "type": "integer",
    },
    "messages": {
      "description": "Conversation so far, oldest first (1-1000 messages). The completion answers the last user message.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "description": "Plain message text (up to 1,000,000 characters). Must be non-empty except on assistant messages that carry tool_calls.",
                    "maxLength": 1000000,
                    "type": "string",
                  },
                  {
                    "description": "Multimodal parts: {type:'text', text} and/or {type:'image_url', image_url:{url, detail?}}. Image parts require a vision-capable model (constraints.vision in xbrush_list_models — all current models except glm-5.2 and deepseek-v4-flash; max images per request in constraints.maxImages).",
                    "items": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "text": {
                              "description": "Text content (non-empty, up to 1,000,000 characters).",
                              "maxLength": 1000000,
                              "minLength": 1,
                              "type": "string",
                            },
                            "type": {
                              "const": "text",
                              "type": "string",
                            },
                          },
                          "required": [
                            "type",
                            "text",
                          ],
                          "type": "object",
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "image_url": {
                              "additionalProperties": false,
                              "properties": {
                                "detail": {
                                  "description": "Vision fidelity vs. cost, passed through to the model vendor: 'low', 'high', or 'auto'. 'low' is drastically cheaper (~98 prompt tokens vs ~1,400 per image on seed-2.0-mini; honored for billing on OpenAI models — constraints.imageDetailHonored); omitted = vendor default (high-tier cost).",
                                  "type": "string",
                                },
                                "url": {
                                  "description": "Image as an https URL or a data: URL (base64). Minimum dimension 14px. Upload local files first with xbrush_file_upload and pass the CDN URL.",
                                  "minLength": 1,
                                  "type": "string",
                                },
                              },
                              "required": [
                                "url",
                              ],
                              "type": "object",
                            },
                            "type": {
                              "const": "image_url",
                              "type": "string",
                            },
                          },
                          "required": [
                            "type",
                            "image_url",
                          ],
                          "type": "object",
                        },
                      ],
                    },
                    "minItems": 1,
                    "type": "array",
                  },
                ],
              },
              {
                "type": "null",
              },
            ],
            "description": "Message content: a plain string, or an array of text/image_url parts (vision). Required (non-empty) on every message except an assistant message with tool_calls, where it may be empty, null, or omitted. For role:'tool' put the function's result here (commonly a JSON string).",
          },
          "role": {
            "description": "Message author: system (instructions), user, assistant (prior model turns), or tool (a function result answering an assistant tool_call). ('developer' is not accepted.)",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool",
            ],
            "type": "string",
          },
          "tool_call_id": {
            "description": "Tool messages only (required there): the id of the assistant tool_calls entry this message answers.",
            "minLength": 1,
            "type": "string",
          },
          "tool_calls": {
            "description": "Assistant messages only: the tool_calls array from a prior response, echoed back VERBATIM when returning function results.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "additionalProperties": false,
                  "properties": {
                    "arguments": {
                      "description": "JSON-encoded arguments STRING (not an object), echoed back verbatim.",
                      "type": "string",
                    },
                    "name": {
                      "description": "Function name as returned by the model.",
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "name",
                    "arguments",
                  ],
                  "type": "object",
                },
                "id": {
                  "description": "Tool call id exactly as the model returned it (e.g. call_abc123).",
                  "minLength": 1,
                  "type": "string",
                },
                "type": {
                  "const": "function",
                  "type": "string",
                },
              },
              "required": [
                "id",
                "type",
                "function",
              ],
              "type": "object",
            },
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "role",
        ],
        "type": "object",
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array",
    },
    "model": {
      "description": "LLM model ID: z-ai/glm-5.2, bytedance/seed-2.0-mini, bytedance/seed-2.1-turbo, google/gemini-3.1-flash-lite, google/gemini-3.5-flash-lite, anthropic/claude-sonnet-5, anthropic/claude-opus-5, deepseek/deepseek-v4-flash, openai/gpt-4o, openai/gpt-4o-mini, openai/gpt-5.4, xai/grok-4.3. Use xbrush_list_models with category='text' to see per-token pricing, vision / function-calling / structured-output support, and per-model param quirks.",
      "type": "string",
    },
    "presence_penalty": {
      "description": "Penalize tokens already present (-2 to 2). Same penaltiesHonored caveat.",
      "maximum": 2,
      "minimum": -2,
      "type": "number",
    },
    "reasoning_effort": {
      "description": "Reasoning budget for reasoning-capable models: none (server default, fastest) / minimal / low / medium / high / max. Per-model adjustments are reported as PARAM_ADJUSTED warnings (gemini: max→high, none→minimal; gpt-5.4: minimal→low, and tools force none; glm-5.2: low/medium→high; gpt-4o family has no reasoning). Higher efforts can exceed the ~30s gateway limit.",
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "max",
      ],
      "type": "string",
    },
    "response_format": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Ask for a syntactically valid JSON object (also mention JSON in the prompt).",
          "properties": {
            "type": {
              "const": "json_object",
              "type": "string",
            },
          },
          "required": [
            "type",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "description": "Constrain the output to a JSON Schema (structured outputs).",
          "properties": {
            "json_schema": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                },
                "name": {
                  "description": "Schema name (required by OpenAI-compatible vendors).",
                  "minLength": 1,
                  "type": "string",
                },
                "schema": {
                  "additionalProperties": {},
                  "description": "JSON Schema the output must conform to.",
                  "type": "object",
                },
                "strict": {
                  "description": "Strict schema adherence (OpenAI structured outputs).",
                  "type": "boolean",
                },
              },
              "required": [
                "name",
              ],
              "type": "object",
            },
            "type": {
              "const": "json_schema",
              "type": "string",
            },
          },
          "required": [
            "type",
            "json_schema",
          ],
          "type": "object",
        },
      ],
      "description": "Structured output: {type:'json_object'} or {type:'json_schema', json_schema:{name, schema, strict?}}. Honored on models with constraints.structuredOutputHonored (openai/*, gemini-3.5-flash-lite); other models ignore it with a PARAM_DROPPED warning.",
    },
    "stop": {
      "anyOf": [
        {
          "description": "A single stop sequence (non-empty).",
          "minLength": 1,
          "type": "string",
        },
        {
          "description": "1-4 stop sequences (non-empty strings).",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
        },
      ],
      "description": "Stop sequence(s): generation halts before emitting any of these. A non-empty string or an array of 1-4. Ignored on xai/grok-4.3 (constraints.stopHonored:false).",
    },
    "temperature": {
      "description": "Sampling temperature (0-2). Higher = more random. Ignored (PARAM_DROPPED warning) on models with constraints.samplingHonored:false — anthropic/*, gemini-3.5-flash-lite, gpt-5.4.",
      "maximum": 2,
      "minimum": 0,
      "type": "number",
    },
    "tool_choice": {
      "anyOf": [
        {
          "description": "'auto' (default — model decides), 'none' (suppress calls this turn), or 'required' (must call something; may yield an empty tool_calls response if no tool fits — prefer 'auto').",
          "minLength": 1,
          "type": "string",
        },
        {
          "additionalProperties": false,
          "description": "Force one specific function. Only models with constraints.forcedChoiceHonored obey this (every current model except z-ai/glm-5.2, which picks its own tool and the response carries a PARAM_NOT_HONORED warning).",
          "properties": {
            "function": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "minLength": 1,
                  "type": "string",
                },
              },
              "required": [
                "name",
              ],
              "type": "object",
            },
            "type": {
              "const": "function",
              "type": "string",
            },
          },
          "required": [
            "type",
            "function",
          ],
          "type": "object",
        },
      ],
      "description": "How the model may use \`tools\`: 'auto' (default), 'none', 'required', or {type:'function', function:{name}} to force one function (models with constraints.forcedChoiceHonored only — glm-5.2 ignores it with a PARAM_NOT_HONORED warning).",
    },
    "tools": {
      "description": "Function definitions the model may call (OpenAI format; ≤32 functions, ≤32KB serialized). All current models support function calling (constraints.functionCalling). Tool schemas are billed as input tokens on EVERY request plus a fixed per-model overhead (constraints.toolsFixedTokens: 50-500) — omit on requests that don't need them.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "function": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "description": "What the function does — helps the model decide when to call it.",
                "type": "string",
              },
              "name": {
                "description": "Function name: 1-64 chars of letters, digits, _ or - (server-enforced).",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$",
                "type": "string",
              },
              "parameters": {
                "additionalProperties": {},
                "description": "JSON Schema object describing the function's arguments (OpenAI format). Omit for a no-argument function.",
                "type": "object",
              },
            },
            "required": [
              "name",
            ],
            "type": "object",
          },
          "type": {
            "const": "function",
            "type": "string",
          },
        },
        "required": [
          "type",
          "function",
        ],
        "type": "object",
      },
      "maxItems": 32,
      "type": "array",
    },
    "top_p": {
      "description": "Nucleus sampling probability mass (0-1). Same samplingHonored caveat as temperature.",
      "maximum": 1,
      "minimum": 0,
      "type": "number",
    },
  },
  "required": [
    "model",
    "messages",
  ],
  "type": "object",
}
`;

