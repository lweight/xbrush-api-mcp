exports[`도구 스키마 스냅샷 > xbrush_image_edit 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "aspect_ratio": {
      "description": "Aspect ratio for resolution-based edit models (e.g. "16:9"). gpt-image-2-edit supports 1:1, 3:2, 2:3, 4:3, 3:4, 4:5, 16:9, 9:16, 21:9, 1.91:1 at 1K/2K — at 4K only 16:9, 9:16, 21:9, 1.91:1. Special value "custom" makes gpt-image-2-edit use width×height as the exact output size (both required, each a multiple of 16, longest edge ≤3840, total pixels 655,360–8,294,400). seedream-*-edit / nano-banana-*-edit accept their own sets; an unsupported value is rejected with the list of allowed ratios.",
      "minLength": 1,
      "type": "string",
    },
    "background": {
      "description": "Background handling for models that support it (e.g. gpt-image-2 transparent PNGs): auto (default), opaque, transparent.",
      "enum": [
        "auto",
        "opaque",
        "transparent",
      ],
      "type": "string",
    },
    "guidance_scale": {
      "description": "Guidance scale (0-50) for diffusion edit models that expose it.",
      "maximum": 50,
      "minimum": 0,
      "type": "number",
    },
    "height": {
      "description": "Output height in pixels (256-4096) for megapixel-based models; for outpaint models, the target canvas height. Resolution-based edit models ignore it unless aspect_ratio:"custom" (see width).",
      "maximum": 4096,
      "minimum": 256,
      "type": "integer",
    },
    "idea": {
      "description": "Non-English edit instruction (server-translated). Use prompt for English.",
      "minLength": 1,
      "type": "string",
    },
    "image_url": {
      "description": "URL of the primary source image to edit (also the first reference).",
      "format": "uri",
      "type": "string",
    },
    "image_urls": {
      "description": "Additional reference image URLs (max 9) for models that compose from multiple references (e.g. gpt-image-2-edit, nano-banana-edit, seedream-5.0-pro-edit). Appended after image_url, so the model receives [image_url, ...image_urls]. Omit for single-reference edits.",
      "items": {
        "format": "uri",
        "type": "string",
      },
      "maxItems": 9,
      "minItems": 1,
      "type": "array",
    },
    "loras": {
      "description": "Apply trained LoRA(s): [{url, weight}] with the weights URL from xbrush_lora_train output and weight 0-2. Use with a LoRA-capable base model and include the trigger word in the prompt.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "Trained LoRA weights URL (from a completed xbrush_lora_train request).",
            "format": "uri",
            "type": "string",
          },
          "weight": {
            "description": "LoRA strength 0-2 (1 = trained strength).",
            "maximum": 2,
            "minimum": 0,
            "type": "number",
          },
        },
        "required": [
          "url",
          "weight",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
    "mask_url": {
      "description": "Mask image URL. White areas = edit, black areas = preserve. (For object removal / plain hole-filling without a prompt, see xbrush_image_inpaint.)",
      "format": "uri",
      "type": "string",
    },
    "mode": {
      "description": "Deprecated hint — the endpoint no longer recognizes it (ignored server-side). The selected model determines the operation; for outpainting prefer xbrush_image_outpaint.",
      "enum": [
        "inpaint",
        "outpaint",
      ],
      "type": "string",
    },
    "model": {
      "description": "Editing model: qwen-image-edit, nano-banana-edit, nano-banana-2-edit, nano-banana-pro-edit, seedream-4.5-edit, seedream-5.0-pro-edit, flux.2-pro-edit, hunyuan-image-3.0-instruct-edit, gpt-image-2-edit. Use xbrush_list_models(category='image'), featureType 'edit'. For outpainting use xbrush_image_outpaint (dedicated endpoint) or an outpaint model here (flux-outpaint, qwen-outpaint, flux.2-pro-outpaint).",
      "type": "string",
    },
    "n": {
      "description": "Number of edited images (1-8). Default: 1.",
      "maximum": 8,
      "minimum": 1,
      "type": "integer",
    },
    "negative_prompt": {
      "description": "Elements to exclude from the edited image.",
      "type": "string",
    },
    "prompt": {
      "description": "Text instruction describing the desired edits (English; use idea for other languages).",
      "minLength": 1,
      "type": "string",
    },
    "quality": {
      "description": "Output quality tier. Applies to byResolutionAndQuality models (gpt-image-2-edit); higher = better and more expensive. Server default is high if omitted.",
      "enum": [
        "low",
        "medium",
        "high",
      ],
      "type": "string",
    },
    "resolution": {
      "description": "Output resolution tier for resolution-based edit models (gpt-image-2-edit, seedream-*-edit, nano-banana-pro/2-edit). Examples: "1K", "2K", "4K".",
      "minLength": 1,
      "type": "string",
    },
    "sampler": {
      "description": "Sampler name for diffusion edit models that expose it (free-form, model-validated).",
      "minLength": 1,
      "type": "string",
    },
    "seed": {
      "description": "Random seed for reproducible results.",
      "type": "integer",
    },
    "width": {
      "description": "Output width in pixels (256-4096) for megapixel-based models; for outpaint models, the target canvas width. Resolution-based edit models normally ignore it — but with aspect_ratio:"custom", gpt-image-2-edit outputs exactly width×height (both required).",
      "maximum": 4096,
      "minimum": 256,
      "type": "integer",
    },
  },
  "required": [
    "model",
    "prompt",
    "image_url",
  ],
  "type": "object",
}
`;

exports[`도구 스키마 스냅샷 > xbrush_image_generate 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "aspect_ratio": {
      "description": "Aspect ratio for resolution-based models (e.g. "16:9"). gpt-image-2/-edit support 1:1, 3:2, 2:3, 4:3, 3:4, 4:5, 16:9, 9:16, 21:9, 1.91:1 at 1K/2K — at 4K only 16:9, 9:16, 21:9, 1.91:1. Special value "custom" makes gpt-image-2/-edit use width×height as the exact output size (both required, each a multiple of 16, longest edge ≤3840, total pixels 655,360–8,294,400; missing dimensions or out-of-range values return 400). seedream-* / nano-banana-* accept their own sets; an unsupported value is rejected with the list of allowed ratios.",
      "minLength": 1,
      "type": "string",
    },
    "background": {
      "description": "Background handling for models that support it (e.g. gpt-image-2 transparent PNGs): auto (default), opaque, transparent.",
      "enum": [
        "auto",
        "opaque",
        "transparent",
      ],
      "type": "string",
    },
    "cfg": {
      "description": "Classifier-free guidance scale (0-20) for diffusion models that expose it (flux.*, z-image-turbo, qwen-image, sdxl-family). Model default if omitted.",
      "maximum": 20,
      "minimum": 0,
      "type": "number",
    },
    "guidance_scale": {
      "description": "Guidance scale (0-50) — alias recognized by the endpoint for models that name the parameter guidance_scale. Prefer cfg unless the model documents guidance_scale.",
      "maximum": 50,
      "minimum": 0,
      "type": "number",
    },
    "height": {
      "description": "Output height in pixels (256-4096) for megapixel-based models. Default: 1024. Resolution-based models ignore it unless aspect_ratio:"custom" (see width).",
      "maximum": 4096,
      "minimum": 256,
      "type": "integer",
    },
    "idea": {
      "description": "Non-English description (e.g. Korean); the server translates it before generation. Use prompt for English text.",
      "minLength": 1,
      "type": "string",
    },
    "loras": {
      "description": "Apply trained LoRA(s): [{url, weight}] with the weights URL from xbrush_lora_train output and weight 0-2. Use with a LoRA-capable base model (e.g. flux.1-dev, qwen-image, z-image-turbo, netayume-v4, anima-base) and include the LoRA's trigger word in the prompt.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "Trained LoRA weights URL (from a completed xbrush_lora_train request).",
            "format": "uri",
            "type": "string",
          },
          "weight": {
            "description": "LoRA strength 0-2 (1 = trained strength).",
            "maximum": 2,
            "minimum": 0,
            "type": "number",
          },
        },
        "required": [
          "url",
          "weight",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
    "model": {
      "description": "Image model to use (e.g. z-image-turbo, flux.2-pro, seedream-5.0-pro, nano-banana-2, gpt-image-2, hunyuan-image-3.0-instruct). Use xbrush_list_models(category='image') to see available models.",
      "type": "string",
    },
    "n": {
      "description": "Number of images to generate (1-8). Default: 1.",
      "maximum": 8,
      "minimum": 1,
      "type": "integer",
    },
    "negative_prompt": {
      "description": "Elements to exclude from the generated image.",
      "type": "string",
    },
    "prompt": {
      "description": "Text description of the image to generate (English recommended — for other languages use idea).",
      "minLength": 1,
      "type": "string",
    },
    "quality": {
      "description": "Output quality tier. Applies to byResolutionAndQuality models (gpt-image-2/-edit); higher = better and more expensive. Server default is high if omitted.",
      "enum": [
        "low",
        "medium",
        "high",
      ],
      "type": "string",
    },
    "resolution": {
      "description": "Output resolution tier for resolution-based models (gpt-image-2, seedream-*, nano-banana-pro/2). Examples: "1K", "2K", "4K" (nano-banana-2 also "0.5K"). Ignored by megapixel-based models — use width/height for those.",
      "minLength": 1,
      "type": "string",
    },
    "sampler": {
      "description": "Sampler name for diffusion models that expose it (free-form, passed through; model-validated).",
      "minLength": 1,
      "type": "string",
    },
    "scheduler": {
      "description": "Diffusion scheduler name for models that expose it. Server currently accepts "simple" only (rejects others with the allowed list).",
      "minLength": 1,
      "type": "string",
    },
    "seed": {
      "description": "Random seed for reproducible results.",
      "type": "integer",
    },
    "trigger_word": {
      "description": "LoRA trigger word to prepend/inject when generating with a trained LoRA (alternative to writing it in the prompt yourself).",
      "minLength": 1,
      "type": "string",
    },
    "width": {
