exports[`도구 스키마 스냅샷 > xbrush_chat 1`] = `
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "frequency_penalty": {
      "description": "Penalize frequent tokens (-2 to 2).",
      "maximum": 2,
      "minimum": -2,
      "type": "number",
    },
    "max_tokens": {
      "description": "Upper bound on generated tokens (1-65536), reasoning included. Keep modest — the response must finish within the ~30s gateway limit.",
      "maximum": 65536,
      "minimum": 1,
      "type": "integer",
    },
    "messages": {
      "description": "Conversation so far, oldest first (1-1000 messages). The completion answers the last user message.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "description": "Message text (up to 1,000,000 characters).",
            "maxLength": 1000000,
            "type": "string",
          },
          "role": {
            "description": "Message author: system (instructions), user, or assistant (prior model turns).",
            "enum": [
              "system",
              "user",
              "assistant",
            ],
            "type": "string",
          },
        },
        "required": [
          "role",
          "content",
        ],
        "type": "object",
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array",
    },
    "model": {
      "description": "LLM model ID (e.g. z-ai/glm-5.2). Use xbrush_list_models with category='text' to see options and per-token pricing.",
      "type": "string",
    },
    "presence_penalty": {
      "description": "Penalize tokens already present (-2 to 2).",
      "maximum": 2,
      "minimum": -2,
      "type": "number",
    },
    "reasoning_effort": {
      "description": "Reasoning budget for reasoning-capable models. Server default: none (fastest). Higher efforts can exceed the ~30s gateway limit — prefer none/minimal here.",
      "enum": [
        "none",
        "minimal",
        "high",
        "max",
      ],
      "type": "string",
    },
    "temperature": {
      "description": "Sampling temperature (0-2). Higher = more random.",
      "maximum": 2,
      "minimum": 0,
      "type": "number",
    },
    "top_p": {
      "description": "Nucleus sampling probability mass (0-1).",
      "maximum": 1,
      "minimum": 0,
      "type": "number",
    },
  },
  "required": [
    "model",
    "messages",
  ],
  "type": "object",
}
`;

