{
  "name": "@lweight/xbrush-api-mcp",
  "version": "2.7.0",
  "description": "MCP server for the XBrush AI media generation API (image, video, TTS, music, sound effects, lip-sync, video extend/retake, content moderation, watermark)",
  "license": "MIT",
  "author": "Lightweight Inc. <dev@lightweight.kr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lweight/xbrush-api-mcp.git"
  },
  "homepage": "https://github.com/lweight/xbrush-api-mcp#readme",
  "bugs": {
    "url": "https://github.com/lweight/xbrush-api-mcp/issues"
  },
  "keywords": [
    "mcp",
    "xbrush",
    "xbrush-api",
    "ai",
    "image-generation",
    "video-generation",
    "audio-generation",
    "claude",
    "model-context-protocol"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xbrush-api-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.7.9",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
